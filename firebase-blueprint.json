      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 100 },
        "department": { "type": "string", "maxLength": 100 },
        "skills": { "type": "array" },
        "bio": { "type": "string", "maxLength": 2000 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "avatar": { "type": "string", "maxLength": 2000 },
        "activeLocation": { "type": "string", "maxLength": 100 },
        "isApproved": { "type": "boolean" },
        "isAdmin": { "type": "boolean" },
        "lastEditedBy": { "type": "string", "maxLength": 200 },
        "lastEditedByUid": { "type": "string", "maxLength": 128 },
        "lastEditedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "role", "email"]
    },
    "ApprovedMember": {
      "title": "ApprovedMember",
      "description": "Google authenticated user account with team access approval status",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "displayName": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 2000 },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "approvedAt": { "type": "string", "maxLength": 64 },
        "approvedBy": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "lastLoginAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "status"]
    },
    "WorkspaceSettings": {
      "title": "WorkspaceSettings",
      "description": "Shared company logo, exchange rates, and global preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyLogo": { "type": "string", "maxLength": 2000 },
        "exchangeRates": { "type": "object" },
        "lastEditedBy": { "type": "string", "maxLength": 200 },
        "lastEditedByUid": { "type": "string", "maxLength": 128 },
        "lastEditedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id"]
    },
    "ItineraryPassport": {
      "title": "ItineraryPassport",
      "description": "Participant passport details manifest for a tour itinerary",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tripId": { "type": "string", "maxLength": 128 },
        "participantName": { "type": "string", "maxLength": 200 },
        "nationality": { "type": "string", "maxLength": 100 },
        "passportNumber": { "type": "string", "maxLength": 100 },
        "dateOfIssue": { "type": "string", "maxLength": 32 },
        "dateOfExpiry": { "type": "string", "maxLength": 32 },
        "notes": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "lastEditedBy": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "tripId", "participantName", "passportNumber"]
    }
  },
  "firestore": {
    "/itineraries/{itineraryId}": {
      "schema": "Itinerary",
      "description": "Collection of all tour itineraries and travel proposals"
    },
    "/itinerary_passports/{passportId}": {
      "schema": "ItineraryPassport",
      "description": "Collection of itinerary participant passport records"
    },
    "/hotels/{hotelId}": {
      "schema": "Hotel",
      "description": "Collection of accommodation hotel partners"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Collection of suppliers and lone providers"
    },
    "/supplier_bookings/{bookingId}": {
      "schema": "SupplierBooking",
      "description": "Collection of reserved supplier bookings"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Collection of VIP client profiles"
    },
    "/communications/{communicationId}": {
      "schema": "CommunicationRecord",
      "description": "Collection of client communication logs"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Collection of staff tasks and booking checklists"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Collection of client invoices and payments"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Collection of company expenses and disbursements"
    },
    "/activity_catalog/{activityId}": {
      "schema": "ActivityCatalogItem",
      "description": "Collection of activity library items"
    },
    "/saved_descriptions/{snippetId}": {
      "schema": "SavedDescriptionSnippet",
      "description": "Collection of reusable snippet descriptions"
    },
    "/supplier_invoices/{invoiceId}": {
      "schema": "SupplierInvoice",
      "description": "Collection of accounts payable supplier invoices"
    },
    "/staff/{staffId}": {
      "schema": "StaffMember",
      "description": "Collection of internal staff directory profiles"
    },
    "/approved_members/{memberUid}": {
      "schema": "ApprovedMember",
      "description": "Collection of approved team members authorized to access the shared workspace"
    },
    "/admins/{adminUid}": {
      "schema": "ApprovedMember",
      "description": "Collection of administrator credentials for role lookup"
    },
    "/workspace_settings/{settingId}": {
      "schema": "WorkspaceSettings",
      "description": "Shared workspace branding and exchange rates configuration"
    }
  }
}
